# Mirror the env-var contract from app.py — same names, same semantics.
PADDLEOCR_DIR=/kaggle/working/PaddleOCR
WORK_DIR=/kaggle/working
DICT_PATH=/kaggle/working/vietnamese_dict.txt
SVTR_CKPT=/kaggle/input/models/thoandanh/svtr-vietnamese-handwriten/pytorch/default/1/SVTR/Stage2/best_accuracy/best_accuracy
CRNN_CKPT=/kaggle/input/models/thoandanh/crnn-vietnamese-handwriten/pytorch/default/1/CRNN/Stage2/best_accuracy
SVTR_CFG=/kaggle/working/rec_svtr_stage2.yml
CRNN_CFG=/kaggle/working/rec_crnn_stage2.yml
TEMP_DIR=/kaggle/working/temp_infer

# Server-only knobs (viz/ specific, not consumed by app.py)
VIZ_HOST=0.0.0.0
VIZ_PORT=7860
# Comma-separated CORS allow-list for Mode A (Vite dev server).
VIZ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 in notebook mode to open a *.gradio.live tunnel.
GRADIO_SHARE=0
